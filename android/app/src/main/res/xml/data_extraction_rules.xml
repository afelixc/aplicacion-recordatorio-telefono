<?xml version="1.0" encoding="utf-8"?>
<!-- Copia automática de Android (Android 12 o más nuevo): solo la base de
     recordatorios y las preferencias. Las claves de API cifradas no viajan
     (no se pueden abrir en otro teléfono). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="app_flutter/" />
        <include domain="sharedpref" path="FlutterSharedPreferences.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="app_flutter/" />
        <include domain="sharedpref" path="FlutterSharedPreferences.xml" />
    </device-transfer>
</data-extraction-rules>
